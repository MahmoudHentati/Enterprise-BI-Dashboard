@page "/customers"
@rendermode InteractiveServer
@inject DashboardService DashboardSvc
@using System.Globalization
@using EntrepriseDashboardFront.Models

<PageTitle>Clients — EnterpriseCube</PageTitle>

<div class="page-header-block">
    <div class="page-header-left">
        <div class="page-header-icon" style="background:linear-gradient(135deg,#6366f1,#a855f7);">👑</div>
        <div>
            <h1 class="page-header-title">Clients</h1>
            <p class="page-header-sub">Analyse du chiffre d'affaires par client</p>
        </div>
    </div>
    <div class="n-control">
        <label for="topNInput" class="n-label">Afficher le Top :</label>
        <input id="topNInput" type="number" class="n-input" @bind-value="TopN" @bind-value:event="oninput" min="1" max="100" />
        <button class="n-btn" @onclick="LoadData">Actualiser</button>
    </div>
</div>

@if (_loading)
{
    <div class="loading-container">
        <div class="spinner"></div>
        <span class="loading-text">Chargement des données clients...</span>
    </div>
}
else
{
    <!-- Overview KPI -->
    <div class="kpi-grid" style="margin-bottom: 1.5rem;">
        <div class="kpi-card kpi-revenue">
            <div class="kpi-header">
                <span class="kpi-label">CA Premier Client</span>
                <div class="kpi-icon">👑</div>
            </div>
            <div class="kpi-value">@FormatCurrency(_topCustomers.FirstOrDefault()?.Revenue ?? 0)</div>
            <div class="kpi-sub">@(_topCustomers.FirstOrDefault()?.CustomerName ?? "Aucun client")</div>
        </div>

        <div class="kpi-card kpi-paid">
            <div class="kpi-header">
                <span class="kpi-label">Total Commandes Top @TopN</span>
                <div class="kpi-icon">🛒</div>
            </div>
            <div class="kpi-value">@FormatNumber(_topCustomers.Sum(c => c.Orders))</div>
            <div class="kpi-sub">Commandes passées</div>
        </div>

        <div class="kpi-card kpi-rate">
            <div class="kpi-header">
                <span class="kpi-label">Nombre de Clients</span>
                <div class="kpi-icon">📊</div>
            </div>
            <div class="kpi-value">@_topCustomers.Count</div>
            <div class="kpi-sub">Top @TopN sélectionnés</div>
        </div>

        <div class="kpi-card kpi-orders">
            <div class="kpi-header">
                <span class="kpi-label">CA Total Top @TopN</span>
                <div class="kpi-icon">💰</div>
            </div>
            <div class="kpi-value">@FormatCurrency(_topCustomers.Sum(c => c.Revenue))</div>
            <div class="kpi-sub">Chiffre d'affaires cumulé</div>
        </div>
    </div>

    <!-- Chart -->
    <div class="charts-grid charts-grid-1" style="margin-bottom: 1.5rem;">
        <div class="chart-card">
            <div class="chart-header">
                <span class="chart-title">🏆 Répartition CA : Top @TopN Clients</span>
                <span class="chart-badge badge-blue">Clients</span>
            </div>
            @if (_topCustomers.Any())
            {
                <ApexChart TItem="CustomerSalesDto"
                           Options="@_customerChartOptions"
                           Height="300">
                    <ApexPointSeries TItem="CustomerSalesDto"
                                     Items="@_topCustomers"
                                     Name="Chiffre d'Affaires (TND)"
                                     XValue="@(e => e.CustomerName)"
                                     YValue="@(e => (decimal)e.Revenue)"
                                     SeriesType="SeriesType.Bar" />
                </ApexChart>
            }
            else
            {
                <div class="loading-text" style="padding:2rem;text-align:center">Aucune donnée</div>
            }
        </div>
    </div>

    <!-- Detailed Table -->
    <div class="charts-grid charts-grid-1">
        <div class="chart-card">
            <div class="chart-header">
                <span class="chart-title">👥 Classement Détaillé des Clients</span>
                <span class="chart-badge badge-cyan">Top @TopN</span>
            </div>
            <div style="overflow-y:auto; max-height:400px;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nom du Client</th>
                            <th style="text-align:right">Commandes</th>
                            <th style="text-align:right">Total CA</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < _topCustomers.Count; i++)
                        {
                            var c = _topCustomers[i];
                            var rank = i + 1;
                            <tr>
                                <td class="table-rank">@rank</td>
                                <td style="font-weight: 500; color: var(--text-primary);">@c.CustomerName</td>
                                <td class="table-value">@c.Orders</td>
                                <td class="table-value" style="color: #2563eb; font-weight: 700;">@FormatCurrency(c.Revenue)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<style>
    /* Page header */
    .page-header-block {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.75rem;
        padding: 1.25rem 1.5rem;
        background: rgba(30,41,59,0.7);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 14px;
        backdrop-filter: blur(20px);
    }
    .page-header-left {
        display: flex;
        align-items: center;
        gap: 0.9rem;
    }
    .page-header-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }
    .page-header-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: #f8fafc;
        margin: 0;
        line-height: 1.2;
        letter-spacing: -0.02em;
    }
    .page-header-sub {
        font-size: 0.8rem;
        color: #94a3b8;
        margin: 0.15rem 0 0;
    }
    /* Controls */
    .n-control { display: flex; align-items: center; gap: 0.5rem; }
    .n-label { font-size: 0.85rem; color: #94a3b8; font-weight: 500; }
    .n-input { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; padding: 0.45rem 0.8rem; color: #f8fafc; font-size: 0.85rem; width: 72px; text-align: center; }
    .n-input:focus { outline: none; border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.2); }
    .n-btn { background: linear-gradient(135deg,#6366f1,#a855f7); border: none; color: white; padding: 0.45rem 1.1rem; border-radius: 8px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .n-btn:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(99,102,241,0.4); }
</style>

@code {
    private bool _loading = true;
    private int TopN { get; set; } = 10;
    private List<CustomerSalesDto> _topCustomers = [];

    private ApexChartOptions<CustomerSalesDto> _customerChartOptions = new()
    {
        Chart = new Chart { Background = "transparent", Toolbar = new Toolbar { Show = false } },
        Theme = new Theme { Mode = Mode.Dark, Palette = PaletteType.Palette1 },
        Colors = ["#6366f1"],
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true, BorderRadius = 6, BarHeight = "60%" } },
        Grid = new Grid { BorderColor = "rgba(255,255,255,0.06)", StrokeDashArray = 3 },
        Xaxis = new XAxis { Labels = new XAxisLabels { Style = new AxisLabelStyle { Colors = "#94a3b8", FontSize = "11px" } } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Style = new AxisLabelStyle { Colors = "#cbd5e1", FontSize = "12px" } } }],
        Tooltip = new Tooltip { Theme = Mode.Dark, Y = new TooltipY { Formatter = "function(val){ if(val>=1000000) return (val/1000000).toFixed(2)+' M TND'; if(val>=1000) return (val/1000).toFixed(2)+' K TND'; return val.toFixed(2)+' TND'; }" } }
    };

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _loading = true;
        if (TopN <= 0) TopN = 10;
        if (TopN > 100) TopN = 100;
        _topCustomers = await DashboardSvc.GetTopCustomersDynamicAsync(TopN);
        _loading = false;
    }

    private static string FormatCurrency(decimal value)
    {
        if (value >= 1_000_000) return $"{(value / 1_000_000):F2}M TND";
        if (value >= 1_000) return $"{(value / 1_000):F1}K TND";
        return $"{value.ToString("N0", new CultureInfo("fr-FR"))} TND";
    }

    private static string FormatNumber(int value)
    {
        if (value >= 1_000_000) return $"{(value / 1_000_000.0):F1}M";
        if (value >= 1_000) return $"{(value / 1_000.0):F1}K";
        return value.ToString("N0", CultureInfo.InvariantCulture);
    }
}