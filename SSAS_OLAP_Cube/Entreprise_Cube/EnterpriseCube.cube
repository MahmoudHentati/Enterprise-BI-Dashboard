  <MdxScripts>
    <MdxScript dwd:design-time-name="8e52d046-2ade-4127-9bc1-3c2678aa1a19">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
La commande CALCULATE contrôle l'agrégation des cellules feuilles dans le cube.
Si la commande CALCULATE est supprimée ou modifiée, les données au sein du cube sont affectées.
Vous devez modifier cette commande uniquement si vous spécifiez manuellement la façon dont le cube est agrégé.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].PaymentRate
 AS IIF(
    [Measures].[Total Amount] = 0,
    NULL,
    [Measures].[Paid Amount] / [Measures].[Total Amount]
) * 100, 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].VipRevenue
 AS (
    [Customers].[Category Code].[VIP],
    [Measures].[Total Amount]
), 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].RegularSalesAmount
 AS (
    [Customers].[Category Code].[Category Code].[REGULAR],
    [Measures].[Total Amount]
), 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].UnpaidAmount
 AS [Measures].[Total Amount]
-
[Measures].[Paid Amount], 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].AverageQuantityPerOrder
 AS IIF(
    [Measures].[Fact Sales Nombre] = 0,
    NULL,
    [Measures].[Quantity] / [Measures].[Fact Sales Nombre]
), 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].AverageSellingPrice
 AS IIF(
    [Measures].[Quantity] = 0,
    NULL,
    [Measures].[Total Amount] /
    [Measures].[Quantity]
), 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>